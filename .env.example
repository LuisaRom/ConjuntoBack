DB_URL=jdbc:postgresql://HOST:5432/DATABASE
DB_USERNAME=usuario
DB_PASSWORD=clave
JWT_SECRET=tu-secreto-jwt

# Mercado Pago SANDBOX (panel Developers > Credenciales de prueba)
# Access Token: el que empieza por TEST- y es mas largo (NO la Public Key)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Comprador de prueba Colombia (panel MP > Cuentas de prueba)
MERCADOPAGO_TEST_PAYER_EMAIL=test_user_co@testuser.com

# Opcional en local; en Render no hace falta (usa RENDER_EXTERNAL_URL)
# FRONTEND_BASE_URL=http://localhost:5173
# BACKEND_BASE_URL=http://localhost:8080

# Asistente IA
# Opcion A (Claude): IA_PROVEEDOR=anthropic, IA_API_KEY=sk-ant-..., IA_MODELO=claude-haiku-5-5
# Opcion B (Gemini gratis): IA_PROVEEDOR=openai, IA_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai, IA_MODELO=gemini-2.5-flash
# Opcion C (OpenAI): IA_PROVEEDOR=openai, IA_MODELO=gpt-4o-mini
IA_PROVEEDOR=anthropic
IA_API_KEY=
IA_MODELO=
IA_BASE_URL=
IA_NOMBRE_CONJUNTO=Conjunto Residencial
