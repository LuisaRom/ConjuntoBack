DB_URL=jdbc:postgresql://HOST:5432/DATABASE
DB_USERNAME=usuario
DB_PASSWORD=clave
JWT_SECRET=tu-secreto-jwt

# Mercado Pago SANDBOX (panel Developers > Credenciales de prueba)
# Access Token: el que empieza por TEST- y es mas largo (NO la Public Key)
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxx-xxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxxxxxx
MERCADOPAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Opcional en local; en Render no hace falta (usa RENDER_EXTERNAL_URL)
# FRONTEND_BASE_URL=http://localhost:5173
# BACKEND_BASE_URL=http://localhost:8080
